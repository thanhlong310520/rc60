  btnBack: {fileID: 841547627963079489}
  btnBuy: {fileID: 2331520600582288601}
  productData: {fileID: 11400000, guid: 5d3ed69c84b4d2f4d9ac9ed186bb0db5, type: 2}
  txtPrice: {fileID: 8701988986962273049}
  startText: 'Grant early access to Character, 1000gold/day, 50gem/day, 250exp/day,
    20% bonus reward and unlock all item.

    The Vip Subscribe package, valued
    at'
  remainText: ', will be charged when you press the subscribe button. The billing
    cycle frequency will be once per week. You do not need to subscribe to use this
    app. Payment will be charged to your Google Play account upon confirmation of
    the transaction or at the end of any trial period, if applicable. The subscription
    will automatically renew unless auto-renew is turned off at least 24 hours before
    the end of the current period. You can manage and disable the auto-renewal feature
    by going to your account settings on Google Play after purchase.

    Additionally,
    you can cancel the subscription by visiting the <link="https://support.google.com/googleplay/answer/7018481?hl=en-GB&co=GENIE.Platform%3DDesktop"><color=#0080FF><u><b>Google
    Play Subscription Center</b></u></color></link>.'
  txtPolicy: {fileID: 6409151462171277447}
